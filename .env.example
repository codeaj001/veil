# VEIL Environment Variables Template (.env.example)

# Supabase Public API Configuration
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server Service Role Key (Backend Only)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Midnight Preprod Network Configuration
VITE_MIDNIGHT_NETWORK=preprod
VITE_MIDNIGHT_RPC=https://rpc.preprod.midnight.network
VITE_MIDNIGHT_INDEXER=https://indexer.preprod.midnight.network/api/v4/graphql

# Server Port
PORT=3001
